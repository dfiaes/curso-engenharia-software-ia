{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://curso.local/contracts/evidence.schema.json",
  "title": "M02 run evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "started_at", "duration_ms", "command", "runtime", "tools", "input", "output"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "started_at": {"type": "string", "format": "date-time"},
    "duration_ms": {"type": "number", "minimum": 0},
    "command": {"const": "csv-cleaner"},
    "runtime": {"type": "object"},
    "tools": {"type": "object"},
    "input": {"type": "object", "required": ["path", "sha256"]},
    "output": {"type": "object", "required": ["path", "sha256", "rows"]}
  }
}

