{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Manifesto de evidências do PRR M13",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "revision_digest", "items"],
  "properties": {
    "schema_version": { "const": 1 },
    "revision_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "items": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "arquitetura", "dependências", "capacidade", "segurança", "dados",
        "observabilidade", "operação", "acesso", "suporte", "rollback"
      ],
      "properties": {
        "arquitetura": { "$ref": "#/$defs/item" },
        "dependências": { "$ref": "#/$defs/item" },
        "capacidade": { "$ref": "#/$defs/item" },
        "segurança": { "$ref": "#/$defs/item" },
        "dados": { "$ref": "#/$defs/item" },
        "observabilidade": { "$ref": "#/$defs/item" },
        "operação": { "$ref": "#/$defs/item" },
        "acesso": { "$ref": "#/$defs/item" },
        "suporte": { "$ref": "#/$defs/item" },
        "rollback": { "$ref": "#/$defs/item" }
      }
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requirement", "status", "artifact_path", "artifact_sha256", "command",
        "cwd", "returncode", "result", "reviewer", "reviewed_revision_digest",
        "environment", "scenario", "scope", "limitations"
      ],
      "properties": {
        "requirement": { "type": "string", "minLength": 1 },
        "status": { "enum": ["PASS", "FAIL", "BLOCKED"] },
        "artifact_path": { "type": "string", "minLength": 1 },
        "artifact_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "command": { "type": "string", "minLength": 1 },
        "cwd": { "type": "string", "minLength": 1 },
        "returncode": { "type": "integer" },
        "result": { "type": "string", "minLength": 1 },
        "reviewer": { "type": "string", "minLength": 1 },
        "reviewed_revision_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "environment": { "type": "string", "minLength": 1 },
        "scenario": { "type": "string", "minLength": 1 },
        "scope": { "type": "string", "minLength": 1 },
        "limitations": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
