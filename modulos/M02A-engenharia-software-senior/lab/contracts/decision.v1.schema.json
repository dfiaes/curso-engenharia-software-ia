{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://curso.local/m02a/decision.v1.schema.json",
  "title": "Decision v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "outcome",
    "reason_codes",
    "policy_version",
    "contract_version",
    "advisor",
    "reused"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "request_id": {"type": "string"},
    "outcome": {"enum": ["accept", "review", "reject"]},
    "reason_codes": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$"},
      "uniqueItems": true
    },
    "policy_version": {"type": "string"},
    "contract_version": {"enum": ["1.0", "2.0"]},
    "advisor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter", "version", "status", "digest"],
      "properties": {
        "adapter": {"type": "string"},
        "version": {"type": "string"},
        "status": {"enum": ["available", "fallback"]},
        "digest": {"type": ["string", "null"]}
      }
    },
    "reused": {"type": "boolean"}
  }
}

