{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://curso.local/m02a/advisory.v1.schema.json",
  "title": "Advisory v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["category", "risk", "confidence", "signals"],
  "properties": {
    "category": {"enum": ["delivery", "operations", "security", "unknown"]},
    "risk": {"enum": ["low", "medium", "high", "unknown"]},
    "confidence": {"type": "string", "pattern": "^(0(\\.[0-9]{1,4})?|1(\\.0{1,4})?)$"},
    "signals": {
      "type": "array",
      "maxItems": 12,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$"},
      "uniqueItems": true
    }
  }
}

