{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://curso.local/m02a/work-request.v2.schema.json",
  "title": "WorkRequest v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "tenant_id",
    "intent",
    "priority",
    "budget",
    "deadline_at",
    "idempotency_key"
  ],
  "properties": {
    "schema_version": {"const": "2.0"},
    "request_id": {"type": "string", "pattern": "^req-[a-z0-9][a-z0-9-]{2,63}$"},
    "tenant_id": {"type": "string", "pattern": "^tenant-[a-z0-9][a-z0-9-]{1,63}$"},
    "intent": {"type": "string", "minLength": 1, "maxLength": 2000},
    "priority": {"enum": ["low", "normal", "high", "critical"]},
    "budget": {"type": "string", "pattern": "^(0|[1-9][0-9]{0,8})(\\.[0-9]{1,2})?$"},
    "deadline_at": {"type": "string", "format": "date-time"},
    "idempotency_key": {"type": "string", "pattern": "^idem-[A-Za-z0-9_-]{8,120}$"},
    "source": {"enum": ["cli", "import", "automation"]}
  }
}

