{
  "schema_version": "1.0",
  "feature_id": "CAP-001",
  "outcome": "Gerar changelog Markdown somente a partir de commits convencionais locais.",
  "non_goals": [
    "Publicar release",
    "Consultar APIs remotas"
  ],
  "requirements": [
    {
      "id": "RF-001",
      "statement": "Agrupar commits feat e fix por categoria preservando a ordem original.",
      "verification": "tests/test_changelog.py::test_groups_supported_commits",
      "examples": ["feat: busca -> Features"],
      "counterexamples": ["docs: typo -> omitido"]
    }
  ],
  "tasks": [
    {
      "id": "T-001",
      "requirement_ids": ["RF-001"],
      "read_set": ["src/changelog.py"],
      "write_set": ["src/changelog.py", "tests/test_changelog.py"],
      "argv": ["python", "-m", "unittest", "discover", "-s", "tests"]
    }
  ],
  "gates": [
    ["python", "-c", "print('gate semântico demonstrativo: OK')"]
  ]
}
